# Copy this file to .env and change the values:   cp .env.example .env
# .env is in .gitignore — it must NEVER be committed (this repo is PUBLIC).
# Docker Compose reads .env automatically.

# Postgres superuser (only used by the init script, never by the services)
POSTGRES_PASSWORD=change-me-admin

# One password per service database (least privilege)
USERS_DB_PASSWORD=change-me-users
PRODUCTS_DB_PASSWORD=change-me-products
ORDERS_DB_PASSWORD=change-me-orders
PAYMENTS_DB_PASSWORD=change-me-payments
NOTIFICATIONS_DB_PASSWORD=change-me-notifications

# Version label shown in logs, metrics and the X-App-Version header
APP_VERSION=local

# Payment chaos knobs (0 = off). Try CHAOS_DECLINE_RATE=0.3 to see compensation.
CHAOS_LATENCY_MS=0
CHAOS_ERROR_RATE=0
CHAOS_DECLINE_RATE=0
CHAOS_DECLINE_RATE=1
