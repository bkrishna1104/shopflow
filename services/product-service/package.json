{
  "name": "product-service",
  "version": "1.0.0",
  "description": "Product catalog and stock reservation",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pretest": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\"",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
